# Base del cliente HTTP del frontend. Debe incluir `/api`, porque todas las rutas
# del backend cuelgan de ese prefijo (`config/urls.py:11`).
#
# El prefijo `NEXT_PUBLIC_` es OBLIGATORIO: Next solo inyecta en el bundle del
# navegador las variables que empiezan así, y es lo que lee `lib/api.ts:12`.
# El backend por su lado no necesita esta variable: Django no sabe de dónde
# viene el frontend, solo responde a lo que le pidan (y valida el origen con CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000/api