# Copia este archivo como .env y llena los valores
DJANGO_SECRET_KEY=cambia-esto-por-cualquier-texto-largo
DJANGO_DEBUG=True

# Credenciales de PRUEBA de tu aplicación de Mercado Pago
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Opcional: clave secreta del webhook (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=

# Origen del frontend (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Exigir emails tipo test_payer_123@testuser.com al iniciar sesión (solo pruebas)
ENFORCE_TEST_EMAIL=True

# PostgreSQL
POSTGRES_DB=save_carts
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
